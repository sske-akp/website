---
import type { Brand } from '../data/types';

interface Props {
  brand: Brand;
}

const { brand } = Astro.props;

// Show placeholder when logo is missing or a bracketed stub value
const isPlaceholderLogo = !brand.logo || brand.logo.startsWith('[');

// Generate initials (up to 2 chars); fall back to '?' for placeholder names
const initials = brand.name.startsWith('[')
  ? '?'
  : brand.name
      .split(/\s+/)
      .slice(0, 2)
      .map((w) => w[0]?.toUpperCase() ?? '')
      .join('');
---

<div class="bg-surface border border-line rounded-lg p-5 flex flex-col gap-4 transition-colors hover:border-primary/40">

  <!-- Logo / Placeholder -->
  <div class="h-16 flex items-center">
    {isPlaceholderLogo ? (
      <div
        class="w-14 h-14 rounded-lg bg-surface-2 text-primary-text flex items-center justify-center font-display font-bold text-xl select-none"
        aria-hidden="true"
      >
        {initials}
      </div>
    ) : (
      <img
        src={brand.logo}
        alt={`${brand.name} logo`}
        class="h-12 w-auto object-contain"
        loading="lazy"
        decoding="async"
      />
    )}
  </div>

  <!-- Content -->
  <div class="flex flex-col gap-1.5 flex-1">
    <h3 class="font-display font-semibold text-ink">{brand.name}</h3>
    <p class="text-muted text-sm leading-relaxed">{brand.description}</p>
  </div>

  <!-- Category tags -->
  {brand.categoryTags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mt-auto">
      {brand.categoryTags.map((tag) => (
        <span class="bg-surface-2 text-muted rounded-full px-2.5 py-0.5 text-xs">
          {tag}
        </span>
      ))}
    </div>
  )}
</div>
