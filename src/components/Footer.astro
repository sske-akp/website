---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import EnquireButton from './EnquireButton.astro';

const year = new Date().getFullYear();
const wordmark = site.shortName || site.businessName;

const navItems = [
  { label: 'Home',          href: '/' },
  { label: 'Our Story',     href: '/our-story' },
  { label: 'Brands',        href: '/brands' },
  { label: 'What We Serve', href: '/what-we-serve' },
  { label: 'Visit Us',      href: '/visit-us' },
  { label: 'Contact',       href: '/contact' },
] as const;
---

<footer class="bg-surface-2 border-t border-line">
  <div class="container-x py-12 lg:py-16">

    <!-- ── Main grid ──────────────────────────────────────────────── -->
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">

      <!-- Col 1: Brand & CTA -->
      <div class="flex flex-col gap-4">
        <a
          href="/"
          class="flex items-center gap-1.5 font-display font-semibold text-lg text-ink hover:text-primary-text transition w-fit"
          aria-label={site.businessName}
        >
          <Icon name="tabler:bolt" class="size-5 text-primary" aria-hidden="true" />
          <span>{wordmark}</span>
        </a>
        <p class="text-muted text-sm leading-relaxed">{site.tagline}</p>
        <p class="text-muted text-sm">
          Serving {site.address.city}, {site.address.district} since {site.establishedYear}.
        </p>
        <div class="mt-1">
          <EnquireButton
            context="I'd like to enquire about your products"
            size="sm"
          />
        </div>
        {site.social && site.social.length > 0 && (
          <div class="flex items-center gap-4 mt-1">
            {site.social.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="text-muted hover:text-primary-text text-sm transition"
              >
                {s.label}
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Col 2: Quick links -->
      <div>
        <h3 class="font-display font-semibold text-sm uppercase tracking-wider text-ink mb-5">
          Quick Links
        </h3>
        <nav class="flex flex-col gap-2.5" aria-label="Footer navigation">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="text-muted hover:text-primary-text text-sm transition flex items-center gap-1.5"
            >
              <Icon name="tabler:chevron-right" class="size-3.5" aria-hidden="true" />
              {item.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Col 3: Visit info -->
      <div>
        <h3 class="font-display font-semibold text-sm uppercase tracking-wider text-ink mb-5">
          Visit Us
        </h3>
        <div class="flex flex-col gap-4 text-sm text-muted">

          <!-- Address -->
          <address class="not-italic flex gap-2.5">
            <Icon name="tabler:map-pin" class="size-4 text-primary shrink-0 mt-0.5" aria-hidden="true" />
            <span>
              {site.address.line1}
              {site.address.line2 && <Fragment><br />{site.address.line2}</Fragment>}
              <br />
              {site.address.city}, {site.address.district}
              <br />
              {site.address.state}
              {site.address.pincode && ` – ${site.address.pincode}`}
            </span>
          </address>

          <!-- Hours -->
          <div class="flex gap-2.5">
            <Icon name="tabler:clock" class="size-4 text-primary shrink-0 mt-0.5" aria-hidden="true" />
            <div class="flex flex-col gap-0.5">
              {site.hours.map((h) => (
                <div>
                  <span class="text-ink">{h.days}:</span> {h.time}
                </div>
              ))}
            </div>
          </div>

          <!-- Phone -->
          <div class="flex gap-2.5 items-center">
            <Icon name="tabler:phone" class="size-4 text-primary shrink-0" aria-hidden="true" />
            <a
              href={`tel:${site.phone}`}
              class="hover:text-primary-text transition"
            >
              {site.phoneDisplay}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Bottom bar ─────────────────────────────────────────────── -->
    <div class="mt-10 pt-6 border-t border-line flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-xs text-muted">
      <span>&copy; {year} {site.businessName}. All rights reserved.</span>
      <span>Est. {site.establishedYear}</span>
    </div>
  </div>
</footer>
