---
import { Icon } from 'astro-icon/components';

interface Props {
  label?: string;
  ratio?: string;
  icon?: string;
  class?: string;
}

const {
  label = 'Photo coming soon',
  ratio = '16/9',
  icon = 'photo',
  class: className,
} = Astro.props;
---

<div
  class:list={[
    'relative w-full bg-surface-2 border border-dashed border-line rounded-2xl overflow-hidden',
    className,
  ]}
  style={`aspect-ratio: ${ratio}`}
  role="img"
  aria-label={label}
>
  <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6">
    <Icon name={`tabler:${icon}`} class="size-10 text-muted opacity-40" aria-hidden="true" />
    <span class="text-sm text-muted text-center leading-snug">{label}</span>
  </div>
</div>
