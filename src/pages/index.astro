---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EnquireButton from '../components/EnquireButton.astro';
import Button from '../components/Button.astro';
import Reveal from '../components/Reveal.astro';
import CategoryCard from '../components/CategoryCard.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import { brands } from '../data/brands';
import { productCategories } from '../data/productCategories';
import { story } from '../data/story';

const featuredCategories = productCategories.slice(0, 6);

interface Segment {
  icon: string;
  label: string;
  heading: string;
  body: string;
  href: string;
  highlight: boolean;
}

const segments: Segment[] = [
  {
    icon: 'tractor',
    label: 'Agriculture',
    heading: 'Built for the farm',
    body: 'Submersible pumps, flat cables, motor starters — everything to keep irrigation running through every growing season.',
    href: '/what-we-serve#agriculture',
    highlight: false,
  },
  {
    icon: 'home',
    label: 'Home & Retail',
    heading: 'Wired for home',
    body: 'Fans, switches, wiring, lighting, cables — trusted brands at honest prices for homeowners, builders, and electricians.',
    href: '/what-we-serve#retail-home',
    highlight: false,
  },
  {
    icon: 'building-factory-2',
    label: 'Industry',
    heading: 'Powering industry',
    body: 'Switchgear, contactors, control panels, automation components — authorised supply as we strategically grow into industrial.',
    href: '/what-we-serve#industrial',
    highlight: true,
  },
];

const trustItems = [
  { label: 'Established', value: '1998' },
  { label: 'Experience', value: '25+ years' },
  { label: 'Showroom', value: '3 floors' },
  { label: 'Business', value: 'Dealer & distributor' },
];
---

<BaseLayout
  description="Sri Sai Krishna Enterprises — Anakapalli's trusted electrical dealer and distributor since 1998. Pumps, cables, switchgear, fans and more for homes, farms and industry."
>

  <!-- ─── 1. HERO ──────────────────────────────────────────────────────────── -->
  <Section id="hero" bleed class="bg-surface border-b border-line">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center py-8 sm:py-12">
        <div class="lg:col-span-7 flex flex-col gap-5">

          <!-- Eyebrow -->
          <span class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">
            Electrical dealer in Anakapalli · Since 1998
          </span>

          <!-- H1 — only h1 on the page -->
          <h1 class="font-display font-semibold text-3xl sm:text-4xl lg:text-[2.625rem] text-ink leading-tight max-w-3xl">
            Electrical products, brands and local advice under one roof.
          </h1>

          <!-- Subhead -->
          <p class="text-muted text-base sm:text-lg max-w-2xl leading-relaxed">
            Sri Sai Krishna Enterprises is a family-run showroom in Anakapalli carrying pumps, cables, switchgear, fans, wiring accessories and lighting.
          </p>

          <!-- CTAs -->
          <div class="flex flex-wrap gap-3">
            <EnquireButton
              context="I'd like to enquire about your products"
              label="WhatsApp enquiry"
              size="lg"
            />
            <Button href={`tel:${site.phone}`} variant="outline" size="lg">
              <Icon name="tabler:phone" class="size-5" aria-hidden="true" />
              Call showroom
            </Button>
          </div>
        </div>

        <!-- Trust facts -->
        <div class="lg:col-span-5 bg-canvas border border-line rounded-lg p-5 sm:p-6">
          <dl class="grid grid-cols-2 gap-x-5 gap-y-5">
            {trustItems.map((item) => (
              <div class="border-l border-line pl-3">
                <dt class="text-xs uppercase tracking-[0.12em] text-muted">{item.label}</dt>
                <dd class="mt-1 font-display font-semibold text-ink leading-snug">{item.value}</dd>
              </div>
            ))}
          </dl>
        </div>

      </div>
    </Container>
  </Section>


  <!-- ─── 2. POSITIONING STATEMENT ────────────────────────────────────────── -->
  <Section>
    <Reveal>
      <div class="max-w-3xl mx-auto text-center">
        <p class="font-display font-semibold text-2xl sm:text-3xl text-ink leading-tight">
          A practical, local showroom for dependable electrical supply.
        </p>
        <p class="mt-5 text-muted text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
          From wiring a home and replacing a pump to sourcing switchgear for a project, customers come to SSKE for known brands, clear guidance and local availability.
        </p>
      </div>
    </Reveal>
  </Section>


  <!-- ─── 3. WHO WE SERVE ──────────────────────────────────────────────────── -->
  <Section id="who-we-serve" class="bg-surface-2">
    <SectionHeading
      eyebrow="Who we serve"
      title="For every electrical need"
      intro="Three distinct customer types. One trusted source. Stocked and ready in Anakapalli."
      align="center"
    />
    <div class="mt-9 grid grid-cols-1 sm:grid-cols-3 gap-4">
      {segments.map((seg, i) => (
        <Reveal delay={i * 110}>
          <a
            href={seg.href}
            class:list={[
              'group flex flex-col gap-4 p-5 rounded-lg border transition-colors h-full',
              seg.highlight
                ? 'bg-surface border-primary/40 hover:border-primary'
                : 'bg-surface border-line hover:border-primary/40',
            ]}
          >
            <div
              class:list={[
                'w-10 h-10 rounded-md flex items-center justify-center shrink-0',
                seg.highlight
                  ? 'bg-primary/15 text-primary-text'
                  : 'bg-surface-2 text-muted',
              ]}
            >
              <Icon name={`tabler:${seg.icon}`} class="size-5" aria-hidden="true" />
            </div>

            {seg.highlight && (
              <span class="text-xs font-semibold uppercase tracking-[0.14em] text-muted -mb-2">
                Growing focus
              </span>
            )}

            <div class="flex flex-col gap-2 flex-1">
              <h2 class="font-display font-semibold text-lg text-ink">{seg.heading}</h2>
              <p class="text-muted text-sm leading-relaxed">{seg.body}</p>
            </div>

            <div class="flex items-center gap-1.5 text-sm font-medium text-primary-text mt-auto">
              Explore
              <Icon name="tabler:arrow-right" class="size-4" aria-hidden="true" />
            </div>
          </a>
        </Reveal>
      ))}
    </div>
  </Section>


  <!-- ─── 4. WHAT WE STOCK ─────────────────────────────────────────────────── -->
  <Section id="what-we-stock">
    <SectionHeading
      eyebrow="What we stock"
      title="Quality products across every category"
      intro="From a pump for your field to switchgear for your factory — stocked and ready in Anakapalli."
      align="center"
    />
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {featuredCategories.map((cat, i) => (
        <Reveal delay={i * 75}>
          <CategoryCard category={cat} />
        </Reveal>
      ))}
    </div>
    <div class="mt-8 text-center">
      <Button href="/what-we-serve" variant="outline" size="lg">
        See everything we stock →
      </Button>
    </div>
  </Section>


  <!-- ─── 5. BRANDS ────────────────────────────────────────────────────────── -->
  <Section id="brands" class="bg-surface-2">
    <SectionHeading
      eyebrow="Brands we carry"
      title="Brands you trust, under one roof"
      intro="Every brand on our shelves is an authorised partnership — quality you can count on."
      align="center"
    />
    <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      {brands.map((brand, i) => (
        <Reveal delay={i * 60}>
          <div class="bg-surface border border-line rounded-lg px-4 py-4 font-display font-semibold text-lg sm:text-xl text-ink text-center transition-colors hover:border-primary/40 cursor-default select-none">
            {brand.name}
          </div>
        </Reveal>
      ))}
    </div>
    <div class="mt-8 text-center">
      <Button href="/brands" variant="ghost">
        See all brands →
      </Button>
    </div>
  </Section>


  <!-- ─── 6. STORY TEASER ──────────────────────────────────────────────────── -->
  <Section id="our-story" class="bg-surface">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">

      <!-- Photo placeholder — left on desktop -->
      <Reveal>
        <PhotoPlaceholder ratio="4/3" label="[Showroom photo coming soon]" />
      </Reveal>

      <!-- Story text — right on desktop -->
      <Reveal delay={150}>
        <div class="flex flex-col gap-5">
          <SectionHeading
            eyebrow="Our story"
            title={story.heading}
            intro={story.lead}
          />

          <!-- Compact milestones -->
          {story.milestones && story.milestones.length > 0 && (
            <div class="border-l-2 border-primary/30 pl-5 flex flex-col gap-4">
              {story.milestones.map((m) => (
                <div>
                  <span class="block font-display font-bold text-primary-text text-sm uppercase tracking-wide">
                    {m.year}
                  </span>
                  <p class="text-muted text-sm mt-0.5">{m.label}</p>
                </div>
              ))}
            </div>
          )}

          <div>
            <Button href="/our-story" variant="outline">
              Read our story →
            </Button>
          </div>
        </div>
      </Reveal>
    </div>
  </Section>


  <!-- ─── 7. VISIT / CLOSING CTA ──────────────────────────────────────────── -->
  <Section id="visit" bleed class="bg-surface-2 border-y border-line">
    <Container>
      <div class="text-center py-4">

        <Reveal>
          <p class="font-display font-semibold text-2xl sm:text-3xl text-ink leading-tight mb-4">
            Visit the showroom in Anakapalli
          </p>
          <p class="text-muted text-base mb-8 max-w-xl mx-auto leading-relaxed">
            Three floors of electrical products, with staff available to help you compare options and confirm availability.
          </p>
        </Reveal>

        <!-- Address + Hours -->
        <Reveal delay={100}>
          <div class="flex flex-col sm:flex-row gap-6 justify-center mb-8 text-ink">
            <div class="flex items-start gap-2 text-left">
              <Icon name="tabler:map-pin" class="size-5 mt-0.5 shrink-0 text-primary-text" aria-hidden="true" />
              <div class="text-sm">
                <div>{site.address.line1}</div>
                {site.address.line2 && <div>{site.address.line2}</div>}
                <div>{site.address.city}, {site.address.district}</div>
              </div>
            </div>
            <div class="flex items-start gap-2 text-left">
              <Icon name="tabler:clock" class="size-5 mt-0.5 shrink-0 text-primary-text" aria-hidden="true" />
              <div class="text-sm">
                {site.hours.map((h) => (
                  <div>{h.days}: {h.time}</div>
                ))}
              </div>
            </div>
          </div>
        </Reveal>

        <!-- CTAs -->
        <Reveal delay={200}>
          <div class="flex flex-wrap gap-3 justify-center">
            <EnquireButton
              context="I'd like to visit the showroom and have some questions"
              label="Message us on WhatsApp"
              variant="accent"
              size="lg"
            />
            <a
              href={`tel:${site.phone}`}
              class="inline-flex min-h-10 items-center justify-center gap-2 px-5 py-2.5 text-base font-medium rounded-md transition-colors border border-line text-ink bg-surface hover:border-primary hover:text-primary-text"
            >
              <Icon name="tabler:phone" class="size-5" aria-hidden="true" />
              Call now
            </a>
            <a
              href="/visit-us"
              class="inline-flex min-h-10 items-center justify-center gap-2 px-5 py-2.5 text-base font-medium rounded-md transition-colors text-primary-text hover:bg-surface"
            >
              Get directions
            </a>
          </div>
        </Reveal>

      </div>
    </Container>
  </Section>

</BaseLayout>
