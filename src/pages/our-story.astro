---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EnquireButton from '../components/EnquireButton.astro';
import Button from '../components/Button.astro';
import Reveal from '../components/Reveal.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import { story } from '../data/story';

const milestoneCount = story.milestones?.length ?? 0;
---

<BaseLayout
  title="Our Story"
  description="Sri Sai Krishna Enterprises — a family-owned electrical business in Anakapalli since 1998, serving homes, farms, and now industry across Visakhapatnam district."
>

  <!-- ─── Hero header ──────────────────────────────────────────────────────── -->
  <Section class="bg-surface-2">
    <Reveal>
      <SectionHeading
        as="h1"
        eyebrow="Est. 1998 · Anakapalli"
        title={story.heading}
        intro={story.lead}
        align="center"
      />
    </Reveal>
  </Section>


  <!-- ─── Story body ───────────────────────────────────────────────────────── -->
  <Section>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">

      <!-- Main narrative -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        <Reveal>
          <PhotoPlaceholder ratio="16/9" label="[Showroom interior — photo coming soon]" />
        </Reveal>

        <div class="flex flex-col gap-5 max-w-prose">
          {story.paragraphs.map((para, i) => (
            <Reveal delay={i * 80}>
              <p class="text-ink text-base leading-relaxed">{para}</p>
            </Reveal>
          ))}
        </div>
      </div>

      <!-- Sidebar: milestones + second photo -->
      <aside class="lg:col-span-5 flex flex-col gap-8">

        <!-- Milestones timeline -->
        {story.milestones && story.milestones.length > 0 && (
          <Reveal delay={120}>
            <div>
              <h2 class="font-display font-semibold text-xl text-ink mb-6">
                Key milestones
              </h2>
              <ol class="flex flex-col">
                {story.milestones.map((m, i) => (
                  <li class="flex gap-4">
                    <!-- Timeline spine -->
                    <div class="flex flex-col items-center pt-1 shrink-0">
                      <div class="w-3 h-3 rounded-full bg-primary"></div>
                      {i < milestoneCount - 1 && (
                        <div class="w-px flex-1 bg-line mt-2"></div>
                      )}
                    </div>
                    <!-- Content -->
                    <div class="pb-8">
                      <span class="block font-display font-bold text-primary-text text-sm uppercase tracking-wide mb-1">
                        {m.year}
                      </span>
                      <p class="text-ink text-sm leading-relaxed">{m.label}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          </Reveal>
        )}

        <Reveal delay={200}>
          <PhotoPlaceholder ratio="4/3" label="[Team / showroom exterior — photo coming soon]" />
        </Reveal>

      </aside>
    </div>
  </Section>


  <!-- ─── Closing CTA ──────────────────────────────────────────────────────── -->
  <Section bleed class="bg-surface-2">
    <Container>
      <Reveal>
        <div class="flex flex-col items-center gap-4 text-center">
          <p class="font-display font-semibold text-2xl sm:text-3xl text-ink max-w-xl">
            25 years of trust. Ready to help with your next project.
          </p>
          <p class="text-muted max-w-md">
            Visit the showroom or reach out on WhatsApp — our team is happy to help you find the right product.
          </p>
          <div class="flex flex-wrap gap-3 justify-center pt-2">
            <EnquireButton
              context="I read your story and would like to get in touch"
              label="Chat on WhatsApp"
              size="lg"
            />
            <Button href="/visit-us" variant="outline" size="lg">
              Visit the showroom →
            </Button>
          </div>
        </div>
      </Reveal>
    </Container>
  </Section>

</BaseLayout>
